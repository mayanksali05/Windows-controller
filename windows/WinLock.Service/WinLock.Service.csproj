    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinLock.Service</RootNamespace>
    <AssemblyName>WinLock.Service</AssemblyName>
    <OutputType>Exe</OutputType>
    <Version>0.1.0</Version>
